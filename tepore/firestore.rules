rules_version = '2';

// TEPORE — Regole di sicurezza Firestore
// Da incollare in: Firebase Console -> Firestore Database -> Regole -> Pubblica
//
// Principio: solo utenti autenticati, e ogni documento dati e' leggibile o
// scrivibile solo da chi e' membro della casa (household) a cui appartiene.
// Sostituisce le regole "modalita' test", che SCADONO dopo 30 giorni e ti
// spegnerebbero l'app a meta' agosto.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funzioni di supporto ----------

    function autenticato() {
      return request.auth != null;
    }

    // E' membro della casa indicata? Legge memberIds dal documento household.
    // Firestore mette in cache questa get() dentro la stessa valutazione,
    // quindi anche su una query di 100 bollette conta come una lettura sola.
    function membroDi(householdId) {
      return autenticato()
        && request.auth.uid in
           get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // Scorciatoia usata dalle collezioni dati: vale sia in lettura
    // (documento esistente) sia in scrittura (documento in arrivo).
    function membroDelDocEsistente() {
      return membroDi(resource.data.householdId);
    }

    function membroDelDocInArrivo() {
      return membroDi(request.resource.data.householdId);
    }

    // ---------- profili utente ----------
    match /users/{userId} {
      // Ognuno scrive solo il proprio profilo...
      allow write: if autenticato() && request.auth.uid == userId;
      // ...ma tutti gli autenticati possono LEGGERE i profili, perche' la
      // schermata "Partecipanti" mostra nome ed email degli altri membri.
      allow read: if autenticato();
    }

    // ---------- case (household) ----------
    match /households/{householdId} {
      // Lettura aperta agli autenticati: serve per entrare con il codice
      // invito (joinHouseholdByInviteCode fa una query su inviteCode PRIMA
      // di essere membro — se qui restringiamo, l'adesione si rompe).
      allow read: if autenticato();

      allow create: if autenticato()
        && request.auth.uid in request.resource.data.memberIds;

      // Update: o sei gia' membro, oppure ti stai aggiungendo tu stesso
      // tramite codice invito.
      allow update: if autenticato()
        && (request.auth.uid in resource.data.memberIds
            || request.auth.uid in request.resource.data.memberIds);

      allow delete: if false; // nessuna cancellazione dall'app, per ora
    }

    // ---------- collezioni dati della casa ----------
    // Hanno tutte un campo householdId e vengono filtrate per quello.

    match /bollette/{docId} {
      allow read:   if membroDelDocEsistente();
      allow create: if membroDelDocInArrivo();
      allow update: if membroDelDocEsistente() && membroDelDocInArrivo();
      allow delete: if membroDelDocEsistente();
    }

    match /immondizia_tipi/{docId} {
      allow read:   if membroDelDocEsistente();
      allow create: if membroDelDocInArrivo();
      allow update: if membroDelDocEsistente() && membroDelDocInArrivo();
      allow delete: if membroDelDocEsistente();
    }

    match /immondizia_straordinarie/{docId} {
      allow read:   if membroDelDocEsistente();
      allow create: if membroDelDocInArrivo();
      allow update: if membroDelDocEsistente() && membroDelDocInArrivo();
      allow delete: if membroDelDocEsistente();
    }

    // NOTA: quando aggiungerai nuovi moduli (pulizie, spese, garanzie...)
    // duplica uno di questi blocchi cambiando solo il nome della collezione.
    // Tutto cio' che non e' elencato qui e' vietato per default.
  }
}
