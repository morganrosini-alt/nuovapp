rules_version = '2';

// TEPORE — Regole di sicurezza Firestore  ·  progetto housekeep-9b194
//
// Da pubblicare in: Firebase Console -> Firestore Database -> Regole.
//
// ⚠️ RISCRITTE (31/07): la versione precedente copriva 6 collezioni su 22.
// Tutto il resto (spese, turni, calendario, piante, veicoli, salute...)
// finiva nel "vietato per default", ed era la causa dell'errore
// "Missing or insufficient permissions" visto all'apertura dell'app.
//
// Tre livelli di accesso:
//   1. household  -> tutti i membri della casa
//   2. personale  -> solo l'autore
//   3. coppia     -> solo i due membri della relazione

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- funzioni di supporto ----------------

    function autenticato() {
      return request.auth != null;
    }

    function mioUid() {
      return request.auth.uid;
    }

    // Membro della casa? Le get() dentro le regole sono messe in cache per
    // valutazione, quindi una query su 100 documenti costa una lettura sola.
    function membroDi(householdId) {
      return autenticato()
        && mioUid() in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    function membroDellaRelazione(relationshipId) {
      return autenticato()
        && mioUid() in get(/databases/$(database)/documents/relationships/$(relationshipId)).data.membri;
    }

    // Il documento (esistente o in arrivo) appartiene a una mia casa?
    function casaEsistente() { return membroDi(resource.data.householdId); }
    function casaInArrivo()  { return membroDi(request.resource.data.householdId); }

    // Regola dei contenuti a visibilità multipla (calendario, spese,
    // salvadanai). Deve rispecchiare esattamente le query in scoped.ts.
    function leggibileScoped() {
      return casaEsistente() && (
        resource.data.visibilita == 'household'
        || (resource.data.visibilita == 'personale' && resource.data.autore == mioUid())
        || (resource.data.visibilita == 'coppia'
            && membroDellaRelazione(resource.data.relationshipId))
      );
    }

    function scrivibileScoped() {
      return casaInArrivo() && request.resource.data.autore == mioUid();
    }

    // ---------------- profili utente ----------------
    match /users/{userId} {
      // Lettura aperta ai soli autenticati: "Partecipanti" mostra nome ed
      // email degli altri membri, e servono le chiavi pubbliche per l'E2E.
      allow read: if autenticato();
      allow create, update: if autenticato() && mioUid() == userId;
      allow delete: if false;
    }

    // ---------------- case ----------------
    match /households/{householdId} {
      // Lettura aperta agli autenticati: chi entra con il codice invito deve
      // poter cercare la casa PRIMA di esserne membro. Senza questo,
      // l'adesione non funziona.
      allow read: if autenticato();

      allow create: if autenticato()
        && mioUid() in request.resource.data.memberIds
        && request.resource.data.ownerId == mioUid();

      // I membri possono aggiornare i dati della casa ma NON la lista dei
      // membri: entrare e uscire passa dalle Cloud Functions, che agiscono
      // con privilegi di amministratore.
      allow update: if membroDi(householdId)
        && request.resource.data.memberIds == resource.data.memberIds;

      allow delete: if false;
    }

    // ---------------- relazioni di coppia ----------------
    match /relationships/{relId} {
      allow read: if casaEsistente();
      allow create: if casaInArrivo()
        && mioUid() in request.resource.data.membri
        && request.resource.data.richiedente == mioUid();
      // Conferma/aggiornamento: solo i due interessati.
      allow update: if mioUid() in resource.data.membri;
      allow delete: if mioUid() in resource.data.membri;
    }

    // ---------------- contenuti a visibilità multipla ----------------
    match /calendario/{docId} {
      allow read: if leggibileScoped();
      allow create: if scrivibileScoped();
      allow update, delete: if leggibileScoped();
    }
    match /spese/{docId} {
      allow read: if leggibileScoped();
      allow create: if scrivibileScoped();
      allow update, delete: if leggibileScoped();
    }
    match /salvadanai/{docId} {
      allow read: if leggibileScoped();
      allow create: if scrivibileScoped();
      allow update, delete: if leggibileScoped();
    }

    // ---------------- zona intima (cifrata end-to-end) ----------------
    // Il contenuto è già illeggibile senza la chiave condivisa, ma limitiamo
    // comunque l'accesso ai due membri della coppia.
    match /zona_intima/{docId} {
      allow read, update, delete: if membroDellaRelazione(resource.data.relationshipId);
      allow create: if membroDellaRelazione(request.resource.data.relationshipId)
        && request.resource.data.autore == mioUid();
    }

    // ---------------- salute (strettamente personale) ----------------
    // Nessun altro membro della casa può leggere questi documenti, nemmeno
    // il proprietario della casa.
    match /salute/{docId} {
      allow read, update, delete: if autenticato() && resource.data.utenteId == mioUid();
      allow create: if autenticato() && request.resource.data.utenteId == mioUid();
    }

    // ---------------- collezioni condivise con tutta la casa ----------------
    // Stesso schema per tutte: campo householdId, accesso ai membri.
    match /{collezione}/{docId} {
      allow read: if collezione in [
            'bollette', 'immondizia_tipi', 'immondizia_straordinarie',
            'bacheca', 'turni', 'pulizie', 'lista_spesa', 'garanzie',
            'manutenzione', 'abbonamenti', 'contatti', 'piante',
            'veicoli', 'animali'
          ] && casaEsistente();

      allow create: if collezione in [
            'bollette', 'immondizia_tipi', 'immondizia_straordinarie',
            'bacheca', 'turni', 'pulizie', 'lista_spesa', 'garanzie',
            'manutenzione', 'abbonamenti', 'contatti', 'piante',
            'veicoli', 'animali'
          ] && casaInArrivo();

      allow update, delete: if collezione in [
            'bollette', 'immondizia_tipi', 'immondizia_straordinarie',
            'bacheca', 'turni', 'pulizie', 'lista_spesa', 'garanzie',
            'manutenzione', 'abbonamenti', 'contatti', 'piante',
            'veicoli', 'animali'
          ] && casaEsistente();
    }

    // Tutto ciò che non è elencato sopra resta vietato.
  }
}
